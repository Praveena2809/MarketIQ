# --- AI (Google Gemini) ---
GEMINI_API_KEY=
# Gemini model used for research synthesis and web (Google Search grounding) queries.
GEMINI_MODEL=gemini-3.6-flash

# Embeddings (Phase 2 RAG) — gemini-embedding-2, 768 dimensions.
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768

# --- Database ---
# Local development default (SQLite file, no setup required):
DATABASE_URL=sqlite:///./marketiq.db
# Production (PostgreSQL), architecture-compatible swap-in:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/marketiq

# --- Vector Database & RAG (Phase 2) ---
VECTOR_DB_DIR=data/chroma
CHROMA_COLLECTION_NAME=marketiq_documents
# Max document chunks retrieved per RAG query.
MAX_RAG_TOP_K=5

# --- Research Engine (Phase 3) ---
# Max number of web research grounding queries per research job.
MAX_RESEARCH_QUERIES=5

# --- Competitor research (Step 6) ---
# Max competitor profiles identified from evidence and researched per job.
MAX_COMPETITORS=5
# Focused per-competitor Google Search grounding (quota-scarce). OFF by
# default; when enabled, at most one grounded search per identified competitor
# and only when it lacks web/news coverage in the existing evidence pool.
COMPETITOR_FOCUSED_WEB_SEARCH=false

# --- News research (Step 5) ---
# Provider: NewsAPI (https://newsapi.org/v2/everything). If NEWS_API_KEY is
# missing, rejected, or quota-exhausted the news agent reports "recent news
# unchecked" honestly and research continues without fabricated articles.
NEWS_API_KEY=
# Look back window for recent news, and how many articles are retained max.
NEWS_RECENCY_DAYS=30
NEWS_RESULTS_PER_QUERY=5
NEWS_QUERY_LIMIT=1
NEWS_LANGUAGE=en

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
SECRET_KEY=change-me-in-production
