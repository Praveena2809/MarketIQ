# --- AI (Google Gemini) ---
GEMINI_API_KEY=
# Gemini model used for research synthesis and web (Google Search grounding) queries.
GEMINI_MODEL=gemini-3.6-flash

# Embeddings (Phase 2 RAG) — gemini-embedding-2, 768 dimensions.
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768

# --- Database ---
# Local development default (SQLite file, no setup required):
DATABASE_URL=sqlite:///./marketiq.db
# Production (PostgreSQL), architecture-compatible swap-in:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/marketiq

# --- Vector Database & RAG (Phase 2) ---
VECTOR_DB_DIR=data/chroma
CHROMA_COLLECTION_NAME=marketiq_documents
# Max document chunks retrieved per RAG query.
MAX_RAG_TOP_K=5

# --- Research Engine (Phase 3) ---
# Max number of web research grounding queries per research job.
MAX_RESEARCH_QUERIES=5

# --- News provider (optional; mock data used if absent) ---
NEWS_API_KEY=

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
SECRET_KEY=change-me-in-production
